#!/bin/bash
# daidai-panel-fn 生命周期入口
#
# Docker 项目由 fnOS 应用中心（docker-project 资源）负责 start/stop，
# 本脚本只做状态上报，必须与 appcenter 的判断保持一致。
#
# 目录约定（关键，踩过坑）：
#   fnOS 安装时会**把 app.tgz 里的 app/ 内容平铺到 TRIM_APPDEST 根目录**，
#   所以 compose 文件在 ${TRIM_APPDEST}/docker/docker-compose.yaml，
#   而不是 ${TRIM_APPDEST}/app/docker/docker-compose.yaml。
#   路径写错会导致 status 恒为 3（未运行）→ 应用中心认为启动失败 →
#   状态卡在 start、桌面入口/图标不注册。

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"

is_docker_running () {
    DOCKER_NAME=""

    if [ -f "$FILE_PATH" ]; then
        DOCKER_NAME=$(grep "container_name" "$FILE_PATH" | awk -F ':' '{print $2}' | xargs)
    fi

    if [ -n "$DOCKER_NAME" ]; then
        docker inspect "$DOCKER_NAME" 2>/dev/null | grep -q '"Status": "running",' || exit 1
        return 0
    fi
    return 1
}

case "${1:-}" in
start)
    # docker 应用由应用中心拉起
    exit 0
    ;;
stop)
    # docker 应用由应用中心停止
    exit 0
    ;;
status)
    if is_docker_running; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
